# FIRETRACE AI - Backend Configuration
# Optional: Enter your NASA FIRMS API Map Key below.
# If left blank, FIRETRACE AI automatically activates its autonomous NASA physics-informed climatology engine.
NASA_MAP_KEY=
FIRMS_API_KEY=

# Local Cache Directory (defaults to ./cache or /app/cache in Docker)
CACHE_DIR=./cache

# Host & Port
HOST=0.0.0.0
BACKEND_PORT=8000
