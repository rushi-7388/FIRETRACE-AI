# FIRETRACE AI - Environment Configuration
# Optional: Enter your NASA FIRMS API Map Key below.
# If left blank or unset, FIRETRACE AI automatically activates its calibrated
# physics-informed synthetic fire climatology fallback engine.
NASA_MAP_KEY=
FIRMS_API_KEY=

# Local Cache Directory (defaults to ./cache or /app/cache in Docker)
CACHE_DIR=/app/cache

# Host port for Frontend (default: 3000 to prevent Windows Port 80 permissions conflicts)
FRONTEND_PORT=4000

# Host port for Backend (default: 8000)
BACKEND_PORT=9000

